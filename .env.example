# --- Auth0 ---
APP_BASE_URL='http://localhost:3000'
AUTH0_SECRET=            # openssl rand -hex 32
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ORG_ID=            # org_xxxx
AUTH0_SCOPE='openid profile email offline_access'

# --- Stripe ---
STRIPE_SECRET_KEY=          # sk_test_xxx
STRIPE_PUBLISHABLE_KEY=     # pk_test_xxx

# Money IN — Billing meter
STRIPE_METER_EVENT_NAME='signet_managed_spend'
STRIPE_METER_ID=            # mtr_test_xxx
STRIPE_PRODUCT_ID=          # prod_xxx
STRIPE_PRICE_ID=            # price_xxx — metered, 1% of managed spend
STRIPE_DEMO_CUSTOMER_ID=    # cus_xxx for the demo org
STRIPE_DEMO_SUBSCRIPTION_ID= # sub_xxx

# --- Agent ---
OPENAI_API_KEY=

# --- DB (Neon Postgres) ---
DATABASE_URL=          # pooled connection string — the app
DATABASE_URL_UNPOOLED= # direct connection string — migrations only
